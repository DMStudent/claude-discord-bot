# === Discord ===
DISCORD_TOKEN=your_bot_token_here
DISCORD_ALLOWED_USERS=123456789,987654321
DISCORD_ALLOWED_ROLES=
DISCORD_ALLOWED_CHANNELS=
DISCORD_REQUIRE_MENTION=true
DISCORD_REACTIONS=true
DISCORD_ALLOW_ATTACHMENTS=true
DISCORD_MAX_ATTACHMENT_SIZE_MB=10
DISCORD_SEND_FILE_OUTPUTS=false

# === Claude Code — Basic ===
CLAUDE_BINARY=claude
CLAUDE_WORKING_DIR=/path/to/your/project
CLAUDE_MODEL=
CLAUDE_PERMISSION_MODE=auto
CLAUDE_MAX_BUDGET_USD=0
CLAUDE_ALLOWED_TOOLS=
CLAUDE_SYSTEM_PROMPT=

# === Claude Code — Enhanced ===
CLAUDE_EFFORT=
CLAUDE_FALLBACK_MODEL=
CLAUDE_ADD_DIRS=
CLAUDE_MCP_CONFIG=
CLAUDE_PLUGINS=
CLAUDE_TASK_BUDGET_TOKENS=0

# === Display ===
SHOW_THINKING=false

# === Session ===
SESSION_TIMEOUT_MINUTES=60
SESSION_MAX_CONCURRENT=5
MESSAGE_QUEUE_SIZE=0

# === Streaming ===
STREAM_EDIT_INTERVAL=0.6
STREAM_BUFFER_THRESHOLD=8
STREAM_CURSOR= |
